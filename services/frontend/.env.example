# Copy to .env (gitignored) and fill in your own Stripe test-mode publishable key
# (dashboard.stripe.com/test/apikeys) — needed client-side to mount Stripe Elements on
# the checkout page. Loaded by docker-compose via env_file (see docker-compose.yaml).
# The matching secret/webhook keys live in services/backend/.env.example instead, since
# only the backend needs them.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
