APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=backend
DB_USERNAME=backend
DB_PASSWORD=backend

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

OPENSEARCH_HOST=http://opensearch:9200

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# LocalStack (local dev only) — real AWS deployments override these via infrastructure/k8s/Terraform.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=product-files
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://localstack:4566
AWS_URL=http://localhost:4566/product-files

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=
JWT_BLACKLIST_ENABLED=false

AZURE_OPENID_CLIENT_ID=
AZURE_OPENID_CLIENT_SECRET_VALUE=
AZURE_OPENID_TENANT_ID=
AZURE_OPENID_REDIRECT_URI=http://localhost:8081/auth/microsoft/callback
AZURE_OPENID_ALLOWED_DOMAIN=

# Web MCP server (/mcp) — Entra token validation. Same tenant as the SSO above
# (MCP_ENTRA_TENANT_ID defaults to AZURE_OPENID_TENANT_ID), dedicated "API" app
# registration. See config/mcp_auth.php and docs/runbook.md.
MCP_ENTRA_TENANT_ID=
# Accepted token "aud" values, comma-separated (Entra uses either the API app's
# Application ID URI or its bare client-id GUID) — e.g. api://<guid>,<guid>
MCP_ENTRA_AUDIENCE=
MCP_ENTRA_SCOPE_URI=
# RFC 8707 resource id in the metadata. Blank = url('/mcp'), which is what strict
# MCP clients expect AND what Entra needs registered as the API app's Application
# ID URI (https://<host>/mcp, requires a verified domain in Entra). Only set this
# to override (e.g. api://<guid>), knowing strict clients then refuse to connect.
MCP_ENTRA_RESOURCE=

# Used by GenerateAttachmentEmbeddingsJob to embed product manual chunks (see docs/design.md).
OPENAI_API_KEY=
