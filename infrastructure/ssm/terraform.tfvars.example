# cp terraform.tfvars.example terraform.tfvars, fill in real values, then `terraform apply`.
# terraform.tfvars is gitignored — same treatment as services/backend/.env.

azure_client_id     = "<z Azure App Registration>"
azure_tenant_id     = "<z Azure App Registration>"
azure_client_secret = "<z Azure App Registration>"
# azure_redirect_uri i azure_allowed_domain mają sensowne default'y (patrz variables.tf) —
# odkomentuj tylko jeśli trzeba je zmienić.
# azure_redirect_uri    = "https://admin.bechta.pl/auth/microsoft/callback"
# azure_allowed_domain  = "bechta.pl"

stripe_secret          = "<z dashboard.stripe.com/apikeys>"
stripe_webhook_secret  = "<signing secret endpointu Stripe Dashboard>"
stripe_publishable_key = "<pk_test_... z dashboard.stripe.com/apikeys>"

openai_api_key = "<z platform.openai.com/api-keys>"
