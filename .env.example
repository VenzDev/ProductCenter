# Root-level env, loaded by docker-compose for ${VAR} substitution (not read by any service
# directly). Copy to .env and fill in your own Stripe test-mode publishable key
# (dashboard.stripe.com/test/apikeys) — needed client-side by the frontend to mount Stripe
# Elements on the checkout page. The matching secret/webhook keys live in
# services/backend/.env.example instead, since only the backend needs them.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
